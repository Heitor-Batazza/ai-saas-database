{
  "name": "ai-saas-database",
  "version": "1.0.0",
  "description": "Core database architecture for a multi-tenant AI SaaS with PostgreSQL, Drizzle ORM, and pgvector",
  "type": "module",
  "main": "src/db/index.ts",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:query": "tsx src/db/queries.ts",
    "db:add-user": "tsx src/db/add-user.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "postgresql",
    "drizzle-orm",
    "pgvector",
    "ai-saas",
    "typescript",
    "multi-tenancy"
  ],
  "author": "Heitor Batazza",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "postgres": "^3.4.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
